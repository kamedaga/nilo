flow {
    start: WeatherHome
    WeatherHome -> CityDetail
    CityDetail -> WeatherHome
    WeatherHome -> RegionSelect
    RegionSelect -> WeatherHome
    RegionSelect -> CityDetail
}

timeline WeatherHome(background: "#ffffff") {
    font: "japanese"
    VStack(style: {
        width: 100ww,
        height: 100wh,
        padding: [20px, 16px],
        gap: 20px,
        align: "center",
        background: "#eff6ff"
    }) {
        // ヒーローセクション
        VStack(style: {
            width: 100%,
            background: "#1e40af",
            padding: [24px, 28px],
            gap: 10px
        }) {
            Text("☀️ Nilo Weather", style: {font_size: 28px, color: "#ffffff", font_weight: "bold"})
            Text("全国の空模様をチェック", style: {font_size: 16px, color: "#dbeafe", line_height: 1.5})
        }

        if state.cards.len() == 0 {
            VStack(style: {
                width: 100%,
                padding: [24px, 20px],
                gap: 10px,
                align: "center",
                background: "#ffffff",
                rounded: 20px,
                border_width: 2,
                border_color: "#bfdbfe"
            }) {
                Text("💭 データがありません", style: {font_size: 18px, color: "#1e40af", font_weight: "bold"})
                Text("※ Tsukumijima Weather から情報を取得できませんでした", style: {font_size: 14px, color: "#3b82f6", max_width: 640px, line_height: 1.5})
            }
        } else {
            VStack(style: {width: 100%, gap: 10px, align: "center"}) {
                // 地方カードボタン（横並び）
                VStack(style: {width: 100%, gap: 12px, max_width: 900px}) {
                    HStack(style: {width: 100%, gap: 12px, align: "start", justify: "space_between"}) {
                        Button(id: region_card_1, label: "⛄ 北海道・東北", onclick: load_region("hokkaido_tohoku"), style: {width: 32%, background: "#dbeafe", color: "#1e3a8a", rounded: 18px, padding: [16px, 12px], font_weight: "bold", border_width: 2, border_color: "#93c5fd"})
                        Button(id: region_card_2, label: "🌸 関東・中部", onclick: load_region("kanto_chubu"), style: {width: 32%, background: "#bfdbfe", color: "#1e40af", rounded: 18px, padding: [16px, 12px], font_weight: "bold", border_width: 2, border_color: "#60a5fa"})
                        Button(id: region_card_3, label: "🌺 西日本", onclick: load_region("west_japan"), style: {width: 32%, background: "#93c5fd", color: "#1e3a8a", rounded: 18px, padding: [16px, 12px], font_weight: "bold", border_width: 2, border_color: "#3b82f6"})
                    }
                }

                // メインカード一覧
                VStack(style: {width: 100%, gap: 12px, max_width: 900px}) {
                    foreach card in state.cards {
                        HStack(style: {
                            width: 100%,
                            background: "#ffffff",
                            rounded: 18px,
                            padding: [16px, 20px],
                            gap: 16px,
                            border_width: 2,
                            border_color: "#bfdbfe",
                            justify: "space_between",
                        }) {
                            Text("🌤️ {}", card, style: {font_size: 15px, color: "#1e293b", font_weight: "bold", line_height: 1.4, max_width: 70%})
                            Button(id: btn_detail, label: "詳細 →", style: {padding: [10px, 18px], background: "#2563eb", color: "#ffffff", font_weight: "bold", rounded: 12px, align: "right"})
                        }
                    }

                    VStack(style: {width: 100%, gap: 8px, background: "#dbeafe", rounded: 18px, padding: [16px, 18px], border_width: 2, border_color: "#93c5fd"}) {
                        Text("🌟 注目セカンドシティ", style: {font_size: 15px, color: "#1e3a8a", font_weight: "bold"})
                        Text("旭川 / 釧路 / 金沢 / 松江 / 高松 / 熊本 / 宮崎 / 宮古島", style: {font_size: 13px, color: "#1e40af", line_height: 1.5})
                    }
                }
            }
        }
        // フッター（最終更新と使用API）
        VStack(style: {
            width: 100%,
            align: "center",
            gap: 6px,
            padding: [8px, 10px]
        }) {
            Text("⏱️ 最終更新: {}", state.updated, style: {font_size: 13px, color: "#64748b"})
            Text("🌐 API: Tsukumijima Weather API", style: {font_size: 13px, color: "#94a3b8"})
        }

    }
    when user.click(btn_detail) { navigate_to(CityDetail) }
    when user.click(region_card_1) { navigate_to(RegionSelect) }
    when user.click(region_card_2) { navigate_to(RegionSelect) }
    when user.click(region_card_3) { navigate_to(RegionSelect) }
}

timeline CityDetail(background: "#eff6ff") {
    font: "japanese"
    VStack(style: {
        width: 100ww,
        height: 100wh,
        padding: [16px, 14px],
        gap: 10px,
        align: "center",
        background: "#eff6ff"
    }) {
        HStack(style: {gap: 10px, align: "center", width: 100%, max_width: 740px}) {
            Button(id: back_btn, label: "← 戻る", style: {
                padding: [8px, 12px],
                background: "#dbeafe",
                color: "#1e40af",
                rounded: 10px,
                border_width: 2,
                border_color: "#93c5fd"
            })
            Text("{} の3日分", state.selected_city, style: {
                font_size: 18px,
                color: "#1e40af",
                font_weight: "bold"
            })
        }

        Text("更新: {}", state.detail_updated, style: {font_size: 13px, color: "#3b82f6"})

        

        VStack(style: {width: 100%, max_width: 740px, gap: 10px}) {
            foreach day in state.detail_days {
                VStack(style: {
                    width: 100%,
                    background: "#ffffff",
                    rounded: 12px,
                    padding: [12px, 14px],
                    gap: 6px,
                    border_width: 2,
                    border_color: "#bfdbfe"
                }) {
                    Text("{}", day, style: {font_size: 15px, color: "#1e40af", font_weight: "bold", line_height: 1.4})
                }
            }
        }

        VStack(style: {width: 100%, max_width: 740px, gap: 6px, rounded: 14px, padding: [14px, 16px], border_width: 2, border_color: "#bfdbfe"}) {
            Text("🌤️ 天気の説明", style: {font_size: 15px, color: "#1e40af", font_weight: "bold"})
            Text("{}", state.weather_description, style: {font_size: 13px, color: "#3b82f6", line_height: 1.6})
        }
    }

    when user.click(back_btn) {
        navigate_to(WeatherHome)
    }
}

// 地方選択タイムライン
timeline RegionSelect(background: "#eff6ff") {
    font: "japanese"
    VStack(style: {
        width: 100ww,
        height: 100wh,
        padding: [16px, 14px],
        gap: 12px,
        align: "center"
    }) {
        VStack(style: {
            width: 100%,
            background: "#1e40af",
            padding: [14px, 16px]
        }) {
            Text("地方を選ぶ", style: {font_size: 20px, color: "#ffffff", font_weight: "bold"})
            Text("地方カードから都市を選択してください", style: {font_size: 13px, color: "#dbeafe"})
        }

        VStack(style: {width: 100%, gap: 8px, max_width: 700px}) {
            if state.region_weather_cards.len() == 0 {
                VStack(style: {padding: [12px, 12px], background: "#ffffff", rounded: 12px, border_width: 2, border_color: "#bfdbfe"}) {
                    Text("カードを表示できません", style: {font_size: 14px, color: "#1e40af", font_weight: "bold"})
                    Text("しばらく待つかボタンを押して再取得してください", style: {font_size: 12px, color: "#3b82f6"})
                }
            } else {
                foreach card in state.region_weather_cards {
                    HStack(style: {
                        width: 100%,
                        background: "#ffffff",
                        rounded: 12px,
                        padding: [12px, 16px],
                        gap: 12px,
                        border_width: 2,
                        border_color: "#bfdbfe",
                        justify: "space_between",
                    }) {
                        Text("{}", card, style: {font_size: 14px, color: "#1e293b", font_weight: "bold"})
                        Button(id: region_city_btn, label: "詳細", onclick: select_city_from_card(card), style: {
                            padding: [8px, 14px],
                            background: "#2563eb",
                            color: "#ffffff",
                            font_weight: "bold",
                            rounded: 10px
                        })
                    }
                }
            }
        }

        Button(id: region_back, label: "戻る", style: {
            padding: [8px, 12px],
            background: "#1e40af",
            color: "#ffffff",
            rounded: 10px
        })
    }

    when user.click(region_back) { navigate_to(WeatherHome) }
    when user.click(region_city_btn) { navigate_to(CityDetail) }
}
